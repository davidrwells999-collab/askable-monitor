ASKABLE_REFRESH_TOKEN="<the refresh_token cookie value from auth.askable.com, DevTools Application tab>"
GH_SECRETS_PAT="<fine-grained PAT, this repo only, Secrets: Read and write — used to persist the rotated refresh token>"
NTFY_TOPIC="<a random, hard-to-guess ntfy.sh topic name>"
ASKABLE_USER_ID="<the askable_user_id claim from your JWT, not just any user id>"
